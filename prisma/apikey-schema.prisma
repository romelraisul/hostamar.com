// API Key Management System
// 1. Prisma model (add to schema)
// 2. API key generation & validation
// 3. Middleware for API key auth
// 4. Developer portal page

// --- Step 1: Add to prisma/schema.prisma ---

model ApiKey {
  id            String   @id @default(cuid())
  key           String   @unique
  name          String
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  // Permissions
  canGenerateImage  Boolean @default(true)
  canGenerateVideo  Boolean @default(true)
  canUseChat        Boolean @default(true)
  
  // Rate limiting
  rateLimitPerMinute Int @default(10)
  
  // Usage tracking
  totalRequests     Int @default(0)
  lastUsedAt        DateTime?
  
  // Status
  isActive          Boolean @default(true)
  expiresAt         DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([key])
}

model ApiRequestLog {
  id          String   @id @default(cuid())
  apiKeyId    String
  endpoint    String
  method      String
  statusCode  Int
  responseTime Int // ms
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([apiKeyId, createdAt])
}
