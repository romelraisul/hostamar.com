# litellm-config.final.yaml — permanent Hostamar router config.
# Generated by guard-restore. Safe to keep under git (no secrets).
# Secret loading: read from env when starting container (see permanent.sh).

model_list:
  # PRIMARY: local Ollama fallback. Always on, never 429s.
  - model_name: hostamar-own            # main chat / reasoning
    litellm_params:
      model: ollama/qwen3:8b
      api_base: http://host.docker.internal:11434
      timeout: 1800
      max_retries: 4
      retry_after: 5
      think: false    # V36.66: qwen3 thinking blocks arrive empty via litellm (same as V36.32); direct answers only
  - model_name: hostamar-own-fast       # edge
    litellm_params:
      model: ollama/qwen3.5:4b
      api_base: http://host.docker.internal:11434
      timeout: 1200
      think: false    # V36.32: qwen3.5 thinking blocks arrive empty via litellm; direct answers only
  - model_name: hostamar-lite          # old mobile / old computer tier (2.7GB, fastest)
    litellm_params:
      model: ollama/qwen3.5:2b
      api_base: http://host.docker.internal:11434
      timeout: 600
      think: false    # V36.32: same qwen3.5 thinking-block fix
  - model_name: hostamar-own-coder      # local coder
    litellm_params:
      model: ollama/qwen3.6:latest
      api_base: http://host.docker.internal:11434
      alias: gemma4-12b-code
      timeout: 1800

  # NVIDIA NIM free-tier (cloud, 1M tok/month). Token-guarded.
  - model_name: glm-5.2
    litellm_params:
      model: openai/z-ai/glm-5.2
      api_base: https://integrate.api.nvidia.com/v1
      api_key: os.environ/NVIDIA_API_KEY
      timeout: 300
      max_retries: 0    # let the token guard be the only retry source
  - model_name: minimax-m3
    litellm_params:
      model: openai/minimaxai/minimax-m3
      api_base: https://integrate.api.nvidia.com/v1
      api_key: os.environ/NVIDIA_API_KEY
      timeout: 300
      max_retries: 0

  # KiloCode gateway. Token-guarded. Secret via env.
  - model_name: kilocode-fast
    litellm_params:
      model: openai/kilo-auto/free
      api_base: os.environ/KILOCODE_BASE_URL
      api_key: os.environ/KILOCODE_API_KEY
      timeout: 240
      max_retries: 0

  # B.AI gateway (V47 2026-09-11). Free models, key via env.
  - model_name: bai/glm-5.3-flash
    litellm_params:
      model: openai/glm-5.3-flash
      api_base: https://api.b.ai/v1
      api_key: os.environ/BAI_API_KEY
      timeout: 300
      max_retries: 1
  - model_name: bai/qwen3.8-flash
    litellm_params:
      model: openai/qwen3.8-flash
      api_base: https://api.b.ai/v1
      api_key: os.environ/BAI_API_KEY
      timeout: 300
      max_retries: 1
  - model_name: bai/minimax-m3
    litellm_params:
      model: openai/minimax-m3
      api_base: https://api.b.ai/v1
      api_key: os.environ/BAI_API_KEY
      timeout: 300
      max_retries: 1
  - model_name: bai/kimi-k3
    litellm_params:
      model: openai/kimi-k3
      api_base: https://api.b.ai/v1
      api_key: os.environ/BAI_API_KEY
      timeout: 300
      max_retries: 1

  # Orcarouter gateway (V47 2026-09-11). Free-tier models, key via env.
  - model_name: orca/free
    litellm_params:
      model: openai/orcarouter/free
      api_base: https://api.orcarouter.ai/v1
      api_key: os.environ/ORCA_API_KEY
      timeout: 300
      max_retries: 1
  - model_name: orca/glm-5.3-flash-free
    litellm_params:
      model: openai/z-ai/glm-5.3-flash-free
      api_base: https://api.orcarouter.ai/v1
      api_key: os.environ/ORCA_API_KEY
      timeout: 300
      max_retries: 1
  - model_name: orca/hy3-free
    litellm_params:
      model: openai/tencent/hy3-free
      api_base: https://api.orcarouter.ai/v1
      api_key: os.environ/ORCA_API_KEY
      timeout: 300
      max_retries: 1
  - model_name: orca/deepseek-v4-flash-free
    litellm_params:
      model: openai/deepseek/deepseek-v4-flash-free
      api_base: https://api.orcarouter.ai/v1
      api_key: os.environ/ORCA_API_KEY
      timeout: 300
      max_retries: 1

  # TokenRouter gateway (V74 2026-09-13). Free-tier aggregator; key via env.
  # Fleet primary: all 16 employees pin tokenrouter/auto (z-ai/glm-5.3-free).
  - model_name: tokenrouter/auto
    litellm_params:
      model: openai/z-ai/glm-5.3-free
      api_base: https://api.tokenrouter.com/v1
      api_key: os.environ/TOKENROUTER_API_KEY
      timeout: 300
      max_retries: 1
  - model_name: tokenrouter/nemotron-nano-free
    litellm_params:
      model: openai/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
      api_base: https://api.tokenrouter.com/v1
      api_key: os.environ/TOKENROUTER_API_KEY
      timeout: 300
      max_retries: 1

# Fallback chain (V74: ALL local-ollama fallbacks REMOVED — kilocode 429 used to
# fall back to hostamar-own-coder = ollama/qwen3.6:latest, a 26GB model whose
# disk->RAM load pinned Disk at 7000% and RAM at 100% (vmmemWSL 21.6GB).
# hostamar-* local tier stays in model_list for EXPLICIT requests only — never
# as an automatic fallback. ollama systemd service is disabled on this host.)
router_settings:
  routing_strategy: usage-based-routing
  num_retries: 2
  retry_after: 5
  fallbacks:
    - glm-5.2: ["tokenrouter/auto"]
    - minimax-m3: ["tokenrouter/auto"]
    - kilocode-fast: ["tokenrouter/auto", "orca/free"]
    - bai/glm-5.3-flash: ["orca/free", "tokenrouter/auto"]
    - bai/qwen3.8-flash: ["orca/free", "tokenrouter/auto"]
    - bai/minimax-m3: ["tokenrouter/auto"]
    - bai/kimi-k3: ["tokenrouter/auto"]
    - orca/free: ["tokenrouter/auto", "kilocode-fast"]
    - orca/glm-5.3-flash-free: ["tokenrouter/auto"]
    - orca/hy3-free: ["tokenrouter/auto"]
    - orca/deepseek-v4-flash-free: ["tokenrouter/auto"]
    - tokenrouter/auto: ["orca/free", "bai/glm-5.3-flash"]
    - tokenrouter/nemotron-nano-free: ["tokenrouter/auto"]
  context_window_fallbacks:
    - glm-5.2: ["tokenrouter/auto"]

# LiteLLM server-level config.
general_settings:
  disable_spend_logs: true
  disable_reset_budget: false
  telemetry: false
  ui: false
  disable_end_user_auth: true
litellm_settings:
  drop_params: true
  request_timeout: 600
  num_threads: 8
