public/tv/*.mp4
public/tv/*.m3u8
public/tv/hls/
public/tv/hls2/
# Vercel standalone build copies public/ into .next/standalone/public/ —
# the patterns above don't match there, so the 774MB of MP4s get uploaded
# and hit the 100MB file-size limit. Block the standalone copy too.
.next/standalone/public/tv/*.mp4
.next/standalone/public/tv/*.m3u8
.next/standalone/public/tv/hls/
.next/standalone/public/tv/hls2/
.next/
node_modules/
.git/
*.log
