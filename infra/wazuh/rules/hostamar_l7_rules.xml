<!--
  hostamar.com custom Layer-7 ruleset for Wazuh (rule IDs 100400-100499).
  Decodes Next.js request logs and flags credential-stuffing, endpoint abuse,
  and scanning behavior. Loaded by the manager via the compose mount:
    ./rules/hostamar_l7_rules.xml:/wazuh-config-mount/etc/ossec.conf.d/hostamar_l7_rules.xml
-->
<group name="hostamar,l7,">
  <!-- Next.js request log events: json logline with path+status+ip -->
  <rule id="100401" level="0">
    <decoded_as>json</decoded_as>
    <field name="event_kind">^http_request$</event_kind>
    <description>Hostamar HTTP request event.</description>
  </rule>

  <!-- Auth failures -->
  <rule id="100410" level="5">
    <if_sid>100401</if_sid>
    <field name="path">^/api/auth/</field>
    <field name="status">^40[13]$</field>
    <description>Hostamar auth endpoint returned 401/403.</description>
  </rule>

  <!-- Credential stuffing: 10+ auth failures from one IP in 120s -->
  <rule id="100411" level="10" frequency="10" timeframe="120">
    <if_matched_sid>100410</if_matched_sid>
    <same_srcip />
    <description>Credential stuffing pattern: repeated auth failures from same IP.</description>
  </rule>

  <!-- Admin surface probing -->
  <rule id="100420" level="6">
    <if_sid>100401</if_sid>
    <field name="path">^/admin</field>
    <field name="status">^40[134]$</field>
    <description>Probe against admin surface (40x on /admin).</description>
  </rule>

  <!-- Burst probing: 20+ admin 40x from one IP in 300s -->
  <rule id="100421" level="12" frequency="20" timeframe="300">
    <if_matched_sid>100420</if_matched_sid>
    <same_srcip />
    <description>Admin surface scan burst from same IP.</description>
  </rule>

  <!-- Sensitive endpoint hammering -->
  <rule id="100430" level="4">
    <if_sid>100401</if_sid>
    <regex field="path">^/api/(checkout|payments|webhooks)</regex>
    <field name="status">^4..$</field>
    <description>4xx on sensitive commerce endpoint.</description>
  </rule>

  <!-- Rate-limit tripwire events exported by the app -->
  <rule id="100440" level="6">
    <decoded_as>json</decoded_as>
    <field name="event_kind">^rate_limit_trip$</field>
    <description>Application rate limiter tripped.</description>
  </rule>
</group>
