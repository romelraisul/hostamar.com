# Third-party footage exclusion (enforced by safety-review.sh; not merely gitignore)
# downloaded (cmt*) clips are not our content; publishing them at hostamar.com/tv/
# presents other people's work as ours (YouTube reused-content / copyright).
# Kept on disk for the local tunnel feed; excluded from git and the deploy.
public/tv/cc0_*.mp4
public/tv/clean_cc0_*.mp4
public/tv/cmt[0-9]*.mp4
# public/videos/ mirrors public/tv/: downloaded (cmt*) clips are third-party and
# must NEVER ship to the edge. The force-include below (!public/videos/*.mp4) would
# re-include them without this rule, so it sits AFTER the force-include line.
public/videos/cmt*.mp4
public/videos/cmt*.jpg


# app/sitemap.ts (dynamic route, Turso-backed) serves the real sitemap; a local
# static public/sitemap.xml shadows it with 19 entries / zero tv/watch. Keep out.
public/sitemap.xml

# wrangler dev scratch (bundles, dev worker, temp wasm)
.wrangler/
public/tv/loop.mp4
.venv

# litellm router config: holds api_key structure; never track (real keys once lived
# in litellm-config*.yaml.bak* — see 2026-10-04 incident). Env refs only today.
litellm-config*.yaml*

# third-party travel shorts (content-origin rule: not our content)
public/tv/bogra-*.mp4
public/tv/coxbazar-*.mp4
public/tv/*travel-short*.mp4
