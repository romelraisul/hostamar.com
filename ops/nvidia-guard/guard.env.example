# NVIDIA-only liveness guard + key rotator (Hermes nvidia-direct egress).
# Copy to /home/romel/.hermes/nvidia-guard/guard.env. Key VALUES live in
# NVG_ENV_FILE and are never stored in this file - only the env var NAMES.
NVG_LISTEN_HOST=127.0.0.1
NVG_LISTEN_PORT=12436
NVG_UPSTREAM=https://integrate.api.nvidia.com
NVG_ENV_FILE=/home/romel/.hermes/.env

# The ONLY models this guard ever serves or advertises. Anything else gets a
# ~1ms 404 locally and never reaches upstream (this is what stops catalog
# scanning / batch model-verification storms).
NVG_MODELS=z-ai/glm-5.3-flash,z-ai/glm-5.3,moonshotai/kimi-k3,deepseek-ai/deepseek-v4.1-flash
NVG_KEY_ENVS=NVIDIA_API_KEY,NVIDIA_API_KEY_2,NVIDIA_API_KEY_BACKUP

# --- anti-stampede budget (the "Cannot write to closing transport" fix) -------
# NVIDIA free-tier answers concurrency with 429 or a hung socket. The guard must
# never multiply that load: one client request used to become 3 retries x 2 keys
# x up to 4 candidate models = 24 upstream calls over ~24 minutes.
NVG_MAX_CONCURRENCY=4
NVG_MAX_ATTEMPTS=3
NVG_REQUEST_BUDGET=90
NVG_ATTEMPT_TIMEOUT=60

# --- liveness probes: sequential, never concurrent ---------------------------
NVG_PROBE_TIMEOUT=12
NVG_PROBE_TTL=180

NVG_UPSTREAM_TIMEOUT=120
NVG_DEAD_TTL=600
NVG_UNRESPONSIVE_TTL=240
NVG_KEY_ROTATIONS=4
NVG_KEY_COOLDOWN=20
