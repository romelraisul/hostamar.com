[Unit]
Description=Hostamar radar - one pass over every layer that can break (catch + auto-fix)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/romel/hostamar.com
Environment=PATH=/home/romel/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/lib/wsl/lib
ExecStart=/home/romel/hostamar.com/ops/monitoring/radar.sh --fix
Nice=5
TimeoutStartSec=600
# radar.sh exits 1 when it *finds* problems (that is a report, not a failure).
# Without this, the unit goes "failed", the next pass counts it in its own L5
# systemd check, and the FAIL never clears. Exit >=2 / a signal still fails.
SuccessExitStatus=1
