[Unit]
Description=Hostamar embedding router (:8081, all-local, no OpenRouter)
After=hostamar-ollama.service
Wants=hostamar-ollama.service

[Service]
Type=simple
WorkingDirectory=/home/romel/hostamar-build
Environment=ROUTER_PORT=8081
Environment=OLLAMA_URL=http://127.0.0.1:11434
Environment=OLLAMA_KEEP_ALIVE=5m
ExecStart=/usr/bin/python3 /home/romel/hostamar-build/embedding-router.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
