# /home/romel/hostamar.com/scripts/tv/systemd/tv-ffmpeg.service
# Source-of-truth for the deployed unit at ~/.config/systemd/user/tv-ffmpeg.service.
#
# Rule 4: NEVER feed the encoder the concat playlist directly — the concat demuxer
# stalls at member boundaries on long runs. Encode the pre-concatenated loop.mp4
# (docker/tv-station/makeloop.sh refreshes it) so the encoder reads one flat file.
# ExecStartPre uses clean-hls.sh (script-based pkill) so the kill pattern cannot
# match this shell's own command line (the old `pkill -f "ffmpeg.*live/tv"` killed
# the restream egress too).
[Unit]
Description=Hostamar TV ffmpeg loop (playlist -> local RTMP only)
Requires=tv-rtmp.service
After=tv-rtmp.service

[Service]
Type=simple
Restart=always
RestartSec=5

ExecStartPre=-/bin/bash /home/romel/hostamar-build/scripts/tv/clean-hls.sh

ExecStart=/usr/bin/ffmpeg -re \
  -stream_loop -1 \
  -i /home/romel/hostamar-build/docker/tv-station/videos/loop.mp4 \
  -i /home/romel/hostamar-build/public/logo.png \
  -fflags +genpts -avoid_negative_ts make_zero -use_wallclock_as_timestamps 0 \
  -filter_complex "[0:v]scale=854:480:force_original_aspect_ratio=decrease,pad=854:480:(ow-iw)/2:(oh-ih)/2:color=black,format=yuv420p[base];[1:v]scale=64:-1[wm];[base][wm]overlay=W-w-8:8:format=yuv420,drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf:text='hostamar.com':fontsize=13:fontcolor=white:x=w-text_w-10:y=76[v]" \
  -map "[v]" -map 0:a \
  -c:v libx264 -profile:v baseline -level 3.0 -pix_fmt yuv420p -b:v 600k -maxrate 600k -bufsize 1200k -g 30 -keyint_min 30 -sc_threshold 0 \
  -c:a aac -b:a 64k -ar 48000 -ac 2 \
  -f flv rtmp://127.0.0.1:1935/live/tv

[Install]
WantedBy=default.target
