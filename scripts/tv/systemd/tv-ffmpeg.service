[Unit]
Description=Hostamar TV ffmpeg loop (playlist -> RTMP)
Requires=tv-rtmp.service
After=tv-rtmp.service

[Service]
Type=simple
Restart=always
RestartSec=5
# Single-encoder guarantee: kill any stale publisher + purge corrupted HLS
# before EVERY start. Overlapping publishers cause 0s micro-segments.
ExecStartPre=-/bin/bash -c 'pkill -9 -f "ffmpeg.*live/tv"; sleep 2; podman exec --user root hostamar-tv-rtmp sh -c "rm -rf /tmp/hls/tv/*; mkdir -p /tmp/hls/tv" 2>/dev/null || true; rm -rf /tmp/hls/tv/* 2>/dev/null; mkdir -p /tmp/hls/tv'
ExecStart=/bin/bash -c "echo $$ > /tmp/ffmpeg.pid; exec /usr/bin/ffmpeg -re -f concat -safe 0 -stream_loop -1 -i /home/romel/hostamar-build/docker/tv-station/videos/playlist.host.txt -i /home/romel/hostamar-build/public/logo.png -fflags +genpts -avoid_negative_ts make_zero -use_wallclock_as_timestamps 0 -filter_complex \"[0:v]scale=854:480:force_original_aspect_ratio=decrease,pad=854:480:(ow-iw)/2:(oh-ih)/2:color=black,format=yuv420p[base];[1:v]scale=64:-1[wm];[base][wm]overlay=W-w-8:8:format=yuv420,drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf:text='hostamar.com':fontsize=13:fontcolor=white:x=w-text_w-10:y=76[v]\" -map \"[v]\" -map 0:a -c:v libx264 -profile:v baseline -level 3.0 -pix_fmt yuv420p -b:v 600k -maxrate 600k -bufsize 1200k -g 30 -keyint_min 30 -sc_threshold 0 -c:a aac -b:a 64k -ar 48000 -ac 2 -f flv rtmp://127.0.0.1:1935/live/tv"

[Install]
WantedBy=default.target
