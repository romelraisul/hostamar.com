# /home/romel/hostamar.com/scripts/tv/systemd/tv-ffmpeg-vp9.service
# Source-of-truth for the deployed unit at ~/.config/systemd/user/tv-ffmpeg-vp9.service.
#
# Rule 4: read the pre-concatenated loop.mp4 (never the concat playlist directly,
# which stalls at member boundaries on long runs). Delegated to vp9-encoder.sh so
# the segment-extension (.mp4) and encoder flags stay in one owned place.
# Rule 5: segments MUST keep a .mp4 extension — Cloudflare caches .mp4 here but
# never .m4s/.ts; hls.js follows the playlist URIs verbatim, so the extension is
# irrelevant to it.
[Unit]
Description=Hostamar TV VP9/Opus HLS variant (low bitrate, edge-cacheable)
After=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=5
ExecStart=/bin/bash /home/romel/hostamar.com/docker/tv-station/vp9-encoder.sh

[Install]
WantedBy=default.target
