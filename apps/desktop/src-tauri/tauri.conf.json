{
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Hostamar Node",
    "version": "0.1.6"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "targets": [
        "msi",
        "nsis",
        "deb",
        "appimage",
        "dmg"
      ],
      "identifier": "com.hostamar.node",
      "icon": [
        "icons/icon.png",
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.ico"
      ]
    },
    "allowlist": {
      "all": true
    },
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "windows": [
      {
        "title": "Hostamar Node",
        "width": 900,
        "height": 600,
        "resizable": true
      }
    ],
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/romelraisul/hostamar.com/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": ""
    }
  }
}
