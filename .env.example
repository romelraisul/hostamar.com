# ═══════════════════════════════════════════════════════════════
# HOSTAMAR — SINGLE SOURCE OF TRUTH for environment variables
# Copy to .env.local and fill values. NEVER commit .env.local.
# Server vars are validated by lib/env.ts (zod).
# ═══════════════════════════════════════════════════════════════

# ── CORE / DATABASE / AUTH ────────────────────────────
APP_BASE_URL=http://localhost:3000
# Postgres connection string (Neon/Supabase/local)
DATABASE_URL=postgresql://hostamar:***@localhost:5432/hostamar
# Secret for signing the auth_token cookie (custom auth)
JWT_SECRET=
# NextAuth session secret
NEXTAUTH_SECRET=
# Canonical site URL, e.g. https://hostamar.com
NEXTAUTH_URL=https://hostamar.com
# Upstash/BullMQ Redis URL (queue + rate limits)
REDIS_URL=redis://localhost:6379

# ── PAYMENTS (personal Send Money + merchant fallback) 
# bKash tokenized checkout app key (merchant; leave empty for personal-only)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_CHECKOUT_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized/Checkout/create
BKASH_ENVIRONMENT=sandbox
BKASH_NUMBER=01822417463
BKASH_PASSWORD=
# Your personal bKash number users send money to
BKASH_PERSONAL_NUMBER=01XXXXXXXXX
BKASH_USERNAME=
BKASH_VERIFY_URL=https://partner.bka.sh/v1.2.0-beta/payment/verify
NAGAD_API_BASE=https://api.nagad.com
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_KEY=
NAGAD_NUMBER=01711317101
NAGAD_PERSONAL_NUMBER=01XXXXXXXXX
NAGAD_VERIFY_URL=https://api.nagad.com/merchant/verify
# Enable P2P Send-Money payments (no merchant docs needed)
PERSONAL_PAYMENT_ENABLED=true
ROCKET_NUMBER=01822417463
ROCKET_PERSONAL_NUMBER=01XXXXXXXXX
# Shared secret for the Android SMS-sync webhook
SMS_WEBHOOK_SECRET=change-me-random-string
USE_PERSONAL_PAYMENTS=true

# ── AI GATEWAY / COMFYUI / LLM PROVIDERS ──────────────
# OpenSEO / DataForSEO — set to enable real SEO audits in /admin/chat /audit
DATAFORSEO_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
OPEN_SEO_URL=
# Founder OS cron secret (must match Vercel env CRON_SECRET and /tmp/setup-crons.sh header)
# CRON_SECRET already defined below — kept as hostamar-cron-2026 for prod crons
COMFYUI_API_BASE=http://localhost:8188
ELEVENLABS_API_KEY=
KILOCODE_API_KEY=
KILOCODE_BASE_URL=https://api.kilo.ai/api/gateway
# OpenRouter (primary 1M gateway) — serves kimi-k3, minimax-m1, etc.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# TokenRouter fallback (OpenRouter-compatible, same models)
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://tokenrouter.app/api/v1
TOKENROUTER_API_KEY_2=
# OpenCode Zen (alternative)
AI_GATEWAY_API_KEY=vgw_xxx # Vercel AI Gateway: vercel.com Dashboard -> AI Gateway -> Create API Key, on Vercel auto VERCEL_OIDC_TOKEN no key needed
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
NVIDIA_API_KEY=
# LiteLLM master key for gateway auth (hostamar-gateway :4000)
LITELLM_MASTER_KEY=sk-hostamar-local-...
OLLAMA_BASE_URL=http://hostamar-ollama:11434
OLLAMA_EMBED_MODEL=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.6:27b
OLLAMA_PUBLIC_URL=https://ollama.hostamar.com
OLLAMA_URL=https://ollama.hostamar.com

# ── CLOUDFLARE TUNNEL (auto-expose local HLS to public) ──────
# Get from Cloudflare dashboard: https://dash.cloudflare.com -> Zero Trust -> Access -> Tunnels
# Create tunnel `hostamar-tv` pointing http://localhost:8080 -> copy token
# Or set CLOUDFLARE_API_TOKEN + CLOUDFLARE_ZONE_ID and admin panel will auto-create it
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_ZONE_ID=
TUNNEL_ID=
# Public HLS URL (auto-filled from tunnel token if present, else set manually e.g. https://xxx.cfargotunnel.com/hls/live/tv/index.m3u8)
TV_HLS_URL=
TV_RTMP_URL=rtmp://localhost:1935/live/tv
# Secret for TV agent polling (generate: openssl rand -hex 16)
TV_AGENT_SECRET=change-me-32-char-random

# ── 24/7 AI TV STATION ────────────────────────────────
# Protects /api/tv/generate-loop and other cron endpoints — also Founder OS daily/weekly crons
CRON_SECRET=hostamar-cron-2026
FACEBOOK_GROUP_1=
FACEBOOK_GROUP_2=
FACEBOOK_GROUP_3=
FACEBOOK_GROUP_4=
FACEBOOK_GROUP_5=
FACEBOOK_RTMP_URL=rtmps://live-api-s.facebook.com:443/rtmp
FACEBOOK_STREAM_KEY=
# Comma-separated RSS feeds for TV auto-generation
RSS_FEEDS=https://www.prothomalo.com/feed,https://feeds.bbci.co.uk/news/world/rss.xml,https://techcrunch.com/feed/
TV_AUTO_GENERATE_ENABLED=true
TV_CHANNEL_NAME="Hostamar TV"
TWITCH_RTMP_URL=rtmp://live-sin.rtmp.twitch.tv/app
TWITCH_STREAM_KEY=
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
YOUTUBE_STREAM_KEY=

# ── STORAGE / VECTOR DB ───────────────────────────────
QDRANT_PUBLIC_URL=https://qdrant.hostamar.com
QDRANT_URL=https://qdrant.hostamar.com
R2_ACCESS_KEY=
R2_BUCKET=hostamar-videos
R2_ENDPOINT=http://localhost:9000
R2_PUBLIC_URL=http://localhost:9000/hostamar-videos
R2_SECRET_KEY=

# ── COMMS / SSO / SOCIAL ──────────────────────────────
SMTP_FROM=noreply@hostamar.com
SMTP_HOST=smtp.gmail.com
SMTP_PASS=
SMTP_PORT=587
SMTP_USER=
TELEGRAM_ADMIN_CHAT_ID=7481317591
TELEGRAM_BOT_TOKEN=

# ── IDE / VOICE / SEARCH ──────────────────────────────
SEARXNG_BASE_URL=http://flociops-searxng:8080

# ── RATE LIMITS / INTERNAL ──────────────────────────────
INTERNAL_API_KEY=
INTERNAL_BASE_URL=http://localhost:3000

# ── PUBLIC (inlined at build time) ────────────────────
NEXT_PUBLIC_API_URL=https://hostamar.com
NEXT_PUBLIC_APP_URL=https://hostamar.com
NEXT_PUBLIC_BUILD_TARGET=api
NEXT_PUBLIC_CONTACT_EMAIL=support@hostamar.com
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SITE_URL=https://hostamar.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@hostamar.com

# ── OTHER ─────────────────────────────────────────────
ALLOW_MOCK_PROVISION=false
EMAIL_FROM=
EMAIL_PASSWORD=
FB_ACCESS_TOKEN=
FB_PAGE_ID=
HARNESS_FILE_ROOT=/app/working
INNGEST_DEV=1
INNGEST_SERVE_HOST=http://172.19.0.1:8288
NEXT_TELEMETRY_DISABLED=1
NODE_VERSION=22.23.1
NX_DAEMON=false
OPENAI_API_KEY=
PORT=3000
POSTGRES_DB=hostamar
POSTGRES_PASSWORD=
POSTGRES_USER=hostamar
QUEUE_SECRET=
SENTRY_ORG=hostamar
SENTRY_PROJECT=hostamar
TURBO_CACHE=remote:rw
TURBO_DOWNLOAD_LOCAL_ENABLED=true
TURBO_REMOTE_ONLY=true
TURBO_RUN_SUMMARY=true
USE_PERSONAL_PAYMENTS=true
VERCEL=1
VERCEL_ENV=production
VERCEL_GIT_COMMIT_AUTHOR_LOGIN=
VERCEL_GIT_COMMIT_AUTHOR_NAME=
VERCEL_GIT_COMMIT_MESSAGE=
VERCEL_GIT_COMMIT_REF=
VERCEL_GIT_COMMIT_SHA=
VERCEL_GIT_PREVIOUS_SHA=
VERCEL_GIT_PROVIDER=
VERCEL_GIT_PULL_REQUEST_ID=
VERCEL_GIT_REPO_ID=
VERCEL_GIT_REPO_OWNER=
VERCEL_GIT_REPO_SLUG=
VERCEL_OIDC_TOKEN=
VERCEL_TARGET_ENV=production
VERCEL_URL=
WA_API_KEY=
YARN_VERSION=1.22.22
YT_API_KEY=

# TV local DB (engine state on this PC; Vercel cannot reach it — serverless)
LOCAL_DATABASE_URL=postgresql://tv:tv_password_local_only_123@127.0.0.1:5433/hostamar_tv

# Cloudflare Turnstile (bot protection on signup) — dash.cloudflare.com > Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
