# Hostamar Environment Variables
# Copy this to .env.local and fill in

# === Database (Neon) ===
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/hostamar?sslmode=require

# === Auth ===
JWT_SECRET=your-minimum-16-char-secret
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === SSO (Google) ===
SSO_CLIENT_ID=your-google-client-id
SSO_CLIENT_SECRET=your-google-client-secret
SSO_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
SSO_TOKEN_URL=https://oauth2.googleapis.com/token
SSO_USERINFO_URL=https://www.googleapis.com/oauth2/v2/userinfo
SSO_SCOPE=openid email profile

# === AI (fal.ai) ===
FAL_API_KEY=your-fal-api-key

# === Redis (Upstash) ===
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# === Storage (R2) ===
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET=hostamar

# === Monitoring ===
SENTRY_DSN=your-sentry-dsn
POSTHOG_API_KEY=your-posthog-key

# === Personal Payments (no business docs needed) ===
PERSONAL_BKASH_NUMBER=01XXXXXXXXX
PERSONAL_NAGAD_NUMBER=01XXXXXXXXX
PERSONAL_ROCKET_NUMBER=01XXXXXXXXX
PERSONAL_USDT_ADDRESS=TLi...your-TRC20-address

# === Bootstrap ===
BOOTSTRAP_SECRET=your-bootstrap-secret-min-8-chars

# === Feature Flags ===
NEXT_PUBLIC_BUILD_TARGET=frontend
